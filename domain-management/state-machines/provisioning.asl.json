{
  "Comment": "Domain resource provisioning workflow",
  "StartAt": "EmitCreationStarted",
  "States": {
    "EmitCreationStarted": {
      "Type": "Task",
      "Resource": "arn:aws:states:::events:putEvents",
      "Parameters": {
        "Entries": [
          {
            "EventBusName": "${ControlPlaneEventBus}",
            "Source": "controlplane.domain-management",
            "DetailType": "DomainCreationStarted",
            "Detail": {
              "requestId.$": "$.detail.requestId",
              "domainId.$": "$.detail.domainId",
              "workflowExecutionId.$": "$$.Execution.Id",
              "startedAt.$": "$$.Execution.StartTime"
            }
          }
        ]
      },
      "ResultPath": null,
      "Next": "CreatePlatformEventBus"
    },
    "CreatePlatformEventBus": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:eventbridge:createEventBus",
      "Parameters": {
        "Name.$": "States.Format('{}-{}-{}-domain-bus', '${Environment}', '${Organization}', $.detail.domainName)"
      },
      "ResultPath": "$.platformBus",
      "Next": "SetPutEventPolicy",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "EmitCreationFailed",
          "ResultPath": "$.error"
        }
      ]
    },
    "SetPutEventPolicy": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:eventbridge:putPermission",
      "Parameters": {
        "EventBusName.$": "$.platformBus.EventBusArn",
        "Action": "events:PutEvents",
        "Principal.$": "$.detail.ownerAccountId",
        "StatementId.$": "States.Format('allow-{}-put-events', $.detail.ownerAccountId)"
      },
      "ResultPath": null,
      "Next": "CreateSchemaRegistry",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "EmitCreationFailed",
          "ResultPath": "$.error"
        }
      ]
    },
    "CreateSchemaRegistry": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:schemas:createRegistry",
      "Parameters": {
        "RegistryName.$": "States.Format('{}-{}-{}-schema-registry', '${Environment}', '${Organization}', $.detail.domainName)",
        "Description.$": "States.Format('Schema registry for domain {}', $.detail.domainName)"
      },
      "ResultPath": "$.schemaRegistry",
      "Next": "CreateSubscriptionDlq",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "EmitCreationFailed",
          "ResultPath": "$.error"
        }
      ]
    },
    "CreateSubscriptionDlq": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:sqs:createQueue",
      "Parameters": {
        "QueueName.$": "States.Format('{}-{}-{}-subscription-dlq', '${Environment}', '${Organization}', $.detail.domainName)"
      },
      "ResultPath": "$.subscriptionDlq",
      "Next": "AssumeAppAccountRole",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "EmitCreationFailed",
          "ResultPath": "$.error"
        }
      ]
    },
    "AssumeAppAccountRole": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:sts:assumeRole",
      "Parameters": {
        "RoleArn.$": "States.Format('arn:aws:iam::{}:role/${Environment}-${Organization}-cp-trust-role', $.detail.ownerAccountId)",
        "RoleSessionName": "control-plane-provisioning"
      },
      "ResultPath": "$.appCredentials",
      "Next": "CreateAppEventBus",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "EmitCreationFailed",
          "ResultPath": "$.error"
        }
      ]
    },
    "CreateAppEventBus": {
      "Type": "Task",
      "Comment": "Creates domain event bus in the application account using assumed role credentials",
      "Resource": "arn:aws:states:::aws-sdk:eventbridge:createEventBus",
      "Parameters": {
        "Name.$": "States.Format('{}-{}-{}-domain-bus', '${Environment}', '${Organization}', $.detail.domainName)"
      },
      "Credentials": {
        "RoleArn.$": "States.Format('arn:aws:iam::{}:role/${Environment}-${Organization}-cp-trust-role', $.detail.ownerAccountId)"
      },
      "ResultPath": "$.appBus",
      "Next": "CreateIntegrationDlq",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "EmitCreationFailed",
          "ResultPath": "$.error"
        }
      ]
    },
    "CreateIntegrationDlq": {
      "Type": "Task",
      "Comment": "Creates integration rule DLQ in the application account using assumed role credentials",
      "Resource": "arn:aws:states:::aws-sdk:sqs:createQueue",
      "Parameters": {
        "QueueName.$": "States.Format('{}-{}-{}-integration-dlq', '${Environment}', '${Organization}', $.detail.domainName)"
      },
      "Credentials": {
        "RoleArn.$": "States.Format('arn:aws:iam::{}:role/${Environment}-${Organization}-cp-trust-role', $.detail.ownerAccountId)"
      },
      "ResultPath": "$.integrationDlq",
      "Next": "CreateDashboard",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "EmitCreationFailed",
          "ResultPath": "$.error"
        }
      ]
    },
    "CreateDashboard": {
      "Type": "Task",
      "Comment": "Creates a CloudWatch dashboard for the domain event bus metrics",
      "Resource": "arn:aws:states:::aws-sdk:cloudwatch:putDashboard",
      "Parameters": {
        "DashboardName.$": "States.Format('{}-{}-{}-domain-dashboard', '${Environment}', '${Organization}', $.detail.domainName)",
        "DashboardBody.$": "States.Format('{\"widgets\":[{\"type\":\"metric\",\"properties\":{\"metrics\":[[\"AWS/Events\",\"Invocations\",\"EventBusName\",\"{}\"],[\"AWS/Events\",\"FailedInvocations\",\"EventBusName\",\"{}\"],[\"AWS/Events\",\"MatchedEvents\",\"EventBusName\",\"{}\"],[\"AWS/Events\",\"ThrottledRules\",\"EventBusName\",\"{}\"],[\"AWS/Events\",\"DeadLetterInvocations\",\"EventBusName\",\"{}\"]],\"period\":300,\"stat\":\"Sum\",\"title\":\"Event Bus Metrics\",\"region\":\"${AWS::Region}\"}},{\"type\":\"metric\",\"properties\":{\"metrics\":[[\"AWS/SQS\",\"NumberOfMessagesReceived\",\"QueueName\",\"{}\"],[\"AWS/SQS\",\"ApproximateNumberOfMessagesVisible\",\"QueueName\",\"{}\"]],\"period\":300,\"stat\":\"Sum\",\"title\":\"Subscription DLQ\",\"region\":\"${AWS::Region}\"}}]}', States.Format('{}-{}-{}-domain-bus', '${Environment}', '${Organization}', $.detail.domainName), States.Format('{}-{}-{}-domain-bus', '${Environment}', '${Organization}', $.detail.domainName), States.Format('{}-{}-{}-domain-bus', '${Environment}', '${Organization}', $.detail.domainName), States.Format('{}-{}-{}-domain-bus', '${Environment}', '${Organization}', $.detail.domainName), States.Format('{}-{}-{}-domain-bus', '${Environment}', '${Organization}', $.detail.domainName), States.Format('{}-{}-{}-subscription-dlq', '${Environment}', '${Organization}', $.detail.domainName), States.Format('{}-{}-{}-subscription-dlq', '${Environment}', '${Organization}', $.detail.domainName))"
      },
      "ResultPath": "$.dashboard",
      "Next": "CreateFailedInvocationsAlarm",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "EmitCreationFailed",
          "ResultPath": "$.error"
        }
      ]
    },
    "CreateFailedInvocationsAlarm": {
      "Type": "Task",
      "Comment": "Creates a CloudWatch alarm for high failure rate on the domain event bus",
      "Resource": "arn:aws:states:::aws-sdk:cloudwatch:putMetricAlarm",
      "Parameters": {
        "AlarmName.$": "States.Format('{}-{}-{}-failed-invocations', '${Environment}', '${Organization}', $.detail.domainName)",
        "AlarmDescription.$": "States.Format('High failed invocations rate on domain bus {}', $.detail.domainName)",
        "Namespace": "AWS/Events",
        "MetricName": "FailedInvocations",
        "Dimensions": [
          {
            "Name": "EventBusName",
            "Value.$": "States.Format('{}-{}-{}-domain-bus', '${Environment}', '${Organization}', $.detail.domainName)"
          }
        ],
        "Statistic": "Sum",
        "Period": 300,
        "EvaluationPeriods": 3,
        "Threshold": 5,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "TreatMissingData": "notBreaching"
      },
      "ResultPath": null,
      "Next": "CreateDlqDepthAlarm",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "EmitCreationFailed",
          "ResultPath": "$.error"
        }
      ]
    },
    "CreateDlqDepthAlarm": {
      "Type": "Task",
      "Comment": "Creates a CloudWatch alarm for DLQ message accumulation",
      "Resource": "arn:aws:states:::aws-sdk:cloudwatch:putMetricAlarm",
      "Parameters": {
        "AlarmName.$": "States.Format('{}-{}-{}-dlq-depth', '${Environment}', '${Organization}', $.detail.domainName)",
        "AlarmDescription.$": "States.Format('Messages accumulating in subscription DLQ for domain {}', $.detail.domainName)",
        "Namespace": "AWS/SQS",
        "MetricName": "ApproximateNumberOfMessagesVisible",
        "Dimensions": [
          {
            "Name": "QueueName",
            "Value.$": "States.Format('{}-{}-{}-subscription-dlq', '${Environment}', '${Organization}', $.detail.domainName)"
          }
        ],
        "Statistic": "Sum",
        "Period": 300,
        "EvaluationPeriods": 2,
        "Threshold": 10,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "TreatMissingData": "notBreaching"
      },
      "ResultPath": null,
      "Next": "UpdateDomainRecord",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "EmitCreationFailed",
          "ResultPath": "$.error"
        }
      ]
    },
    "UpdateDomainRecord": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${DomainsTable}",
        "Key": {
          "domainId": {
            "S.$": "$.detail.domainId"
          }
        },
        "UpdateExpression": "SET #s = :status, resourceArns = :arns, updatedAt = :now",
        "ExpressionAttributeNames": {
          "#s": "status"
        },
        "ExpressionAttributeValues": {
          ":status": {
            "S": "ACTIVE"
          },
          ":arns": {
            "M": {
              "platformEventBusArn": {
                "S.$": "$.platformBus.EventBusArn"
              },
              "appEventBusArn": {
                "S.$": "$.appBus.EventBusArn"
              },
              "schemaRegistryArn": {
                "S.$": "$.schemaRegistry.RegistryArn"
              },
              "subscriptionDlqArn": {
                "S.$": "$.subscriptionDlq.QueueUrl"
              },
              "integrationDlqArn": {
                "S.$": "$.integrationDlq.QueueUrl"
              },
              "dashboardName": {
                "S.$": "States.Format('{}-{}-{}-domain-dashboard', '${Environment}', '${Organization}', $.detail.domainName)"
              }
            }
          },
          ":now": {
            "S.$": "$$.State.EnteredTime"
          }
        }
      },
      "ResultPath": null,
      "Next": "EmitCreationSucceeded"
    },
    "EmitCreationSucceeded": {
      "Type": "Task",
      "Resource": "arn:aws:states:::events:putEvents",
      "Parameters": {
        "Entries": [
          {
            "EventBusName": "${ControlPlaneEventBus}",
            "Source": "controlplane.domain-management",
            "DetailType": "DomainCreationSucceeded",
            "Detail": {
              "requestId.$": "$.detail.requestId",
              "domainId.$": "$.detail.domainId",
              "workflowExecutionId.$": "$$.Execution.Id",
              "completedAt.$": "$$.State.EnteredTime",
              "resourceArns": {
                "platformEventBusArn.$": "$.platformBus.EventBusArn",
                "appEventBusArn.$": "$.appBus.EventBusArn",
                "schemaRegistryArn.$": "$.schemaRegistry.RegistryArn",
                "subscriptionDlqArn.$": "$.subscriptionDlq.QueueUrl",
                "integrationDlqArn.$": "$.integrationDlq.QueueUrl"
              }
            }
          }
        ]
      },
      "End": true
    },
    "EmitCreationFailed": {
      "Type": "Task",
      "Resource": "arn:aws:states:::events:putEvents",
      "Parameters": {
        "Entries": [
          {
            "EventBusName": "${ControlPlaneEventBus}",
            "Source": "controlplane.domain-management",
            "DetailType": "DomainCreationFailed",
            "Detail": {
              "requestId.$": "$.detail.requestId",
              "domainId.$": "$.detail.domainId",
              "workflowExecutionId.$": "$$.Execution.Id",
              "failedAt.$": "$$.State.EnteredTime",
              "errorCode.$": "$.error.Error",
              "errorMessage.$": "$.error.Cause"
            }
          }
        ]
      },
      "Next": "UpdateDomainFailed"
    },
    "UpdateDomainFailed": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${DomainsTable}",
        "Key": {
          "domainId": {
            "S.$": "$.detail.domainId"
          }
        },
        "UpdateExpression": "SET #s = :status, errorDetail = :err, updatedAt = :now",
        "ExpressionAttributeNames": {
          "#s": "status"
        },
        "ExpressionAttributeValues": {
          ":status": {
            "S": "FAILED"
          },
          ":err": {
            "S.$": "$.error.Cause"
          },
          ":now": {
            "S.$": "$$.State.EnteredTime"
          }
        }
      },
      "End": true
    }
  }
}
