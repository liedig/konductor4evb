# Customer platform configuration for Konductor.
#
# Copy this file to konductor-platform.toml and fill in your values. The real
# file is gitignored — it is the one place customer values live. The contract
# for every setting (syntax, defaults, lifecycle) is documented in
# docs/reference/configuration.md. Validate before deploying:
#
#   make validate-config
#
# Existing installation? Generate a starting point from the deployed stack:
#
#   python3 scripts/validate-config.py --init-from-stack > konductor-platform.toml

# Organisation identifier used in resource naming: 2-43 lowercase letters,
# digits, or hyphens, starting and ending with a letter or digit.
# FIXED AT SETUP — changing it on an existing installation means a new deployment.
organization = "acme"

# ARN of the AWS Organization whose accounts may register domains.
# FIXED AT SETUP.
aws_organization_arn = "arn:aws:organizations::123456789012:organization/o-abc123def4"

# Environments every approved domain is provisioned into. 1-10 entries, each
# matching ^[a-z0-9][a-z0-9-]{0,31}$, unique. FIXED AT SETUP.
environments = ["dev", "staging", "prod"]

# Naming convention for domain resources. Must contain {org}, {env}, and
# {domain}; literal characters are lowercase, digits, and hyphens only.
# FIXED AT SETUP.
namespace_pattern = "{org}-{env}-{domain}"

# Notification sender and platform-operator recipient. Set BOTH to enable
# email notifications (both must be verified SES identities in the deploy
# region — see 'make deploy-notifications'); leave BOTH empty to disable.
# Updateable.
notification_sender_email = ""
platform_operator_email = ""

# Cognito access-token validity in minutes (5-1440). Updateable.
access_token_validity_minutes = 60

# Emit SubscriptionUpgradeStarted/SubscriptionUpgraded system events during
# schema re-pins. Rollout gate: deploy with false, stand up the system-events
# infrastructure, then enable (docs/guides/system-events.md). Updateable.
system_event_emission_enabled = false

# OAuth redirect URLs for the console. HTTPS required; plain HTTP is allowed
# only for http://localhost[:port] during local development. Updateable.
oauth_callback_urls = ["http://localhost:3000/callback"]
oauth_logout_urls = ["http://localhost:3000/logout"]
