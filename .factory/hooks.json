{
  "PreToolUse": [
    {
      "matcher": "Execute",
      "commandRegex": "(^|\\s)(rtk\\s+)?git\\s+push(\\s|$)",
      "hooks": [
        {
          "type": "command",
          "command": "\"$FACTORY_PROJECT_DIR\"/.factory/hooks/rust-analyzer-before-push.sh",
          "timeout": 600
        }
      ]
    }
  ]
}
